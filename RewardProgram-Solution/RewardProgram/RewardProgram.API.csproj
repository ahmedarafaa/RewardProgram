<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>9ee13453-4cf0-4b15-a585-7667ea4463e6</UserSecretsId>
    <!--
      Disable the Web SDK's automatic web.config rewriting. Our per-env templates
      (web.Staging.config, web.UAT.config) are already complete; the transform
      would otherwise overwrite them with InProcess/dotnet defaults after publish.
    -->
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.2" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Nanoid" Version="3.1.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="FluentValidation.AspNetCore" Version="11.3.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.0" />
    <PackageReference Include="Twilio" Version="7.14.3" />
    <PackageReference Include="Twilio.AspNet.Core" Version="8.1.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RewardProgram.Infrastructure\RewardProgram.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Controllers\Admin\" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="App_Data\firebase-credentials.json"
             Condition="Exists('App_Data\firebase-credentials.json')"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Update="web.Staging.config" CopyToPublishDirectory="Never" CopyToOutputDirectory="Never" />
    <Content Update="web.UAT.config"     CopyToPublishDirectory="Never" CopyToOutputDirectory="Never" />
    <None Update="web.Staging.config" CopyToPublishDirectory="Never" CopyToOutputDirectory="Never" />
    <None Update="web.UAT.config"     CopyToPublishDirectory="Never" CopyToOutputDirectory="Never" />
  </ItemGroup>

  <!--
    Swap the correct environment web.config template into the publish output based
    on the active publish profile. Runs after ComputeFilesToPublish so our copy
    wins against the normal content-copy for web.config. Templates themselves are
    excluded from publish via CopyToPublishDirectory="Never" above.
  -->
  <Target Name="SwapEnvironmentWebConfig" AfterTargets="CopyFilesToPublishDirectory">
    <PropertyGroup>
      <_EnvTemplate Condition="'$(FtpSitePath)' == 'staging' Or $(PublishProfile.Contains('subsite4'))">web.Staging.config</_EnvTemplate>
      <_EnvTemplate Condition="'$(FtpSitePath)' == 'uat' Or $(PublishProfile.Contains('subsite5'))">web.UAT.config</_EnvTemplate>
    </PropertyGroup>
    <Message Text="Swapping $(_EnvTemplate) into web.config for publish" Importance="High" Condition="'$(_EnvTemplate)' != ''" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\$(_EnvTemplate)"
          DestinationFiles="$(PublishDir)web.config"
          OverwriteReadOnlyFiles="true"
          Condition="'$(_EnvTemplate)' != '' And Exists('$(MSBuildProjectDirectory)\$(_EnvTemplate)')" />
  </Target>

</Project>
