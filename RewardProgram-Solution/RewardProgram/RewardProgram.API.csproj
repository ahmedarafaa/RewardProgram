<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>9ee13453-4cf0-4b15-a585-7667ea4463e6</UserSecretsId>
    <!--
      Disable the Web SDK's _TransformWebConfig target. We deploy one of the
      per-env templates (web.Staging.config / web.UAT.config) verbatim via the
      SwapEnvironmentWebConfig target below, so we need the transform OFF to
      keep it from reading the placeholder web.config and overwriting our swap.
      Templates already carry the known-working InProcess + dotnet + dll form.
    -->
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.2" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Nanoid" Version="3.1.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="FluentValidation.AspNetCore" Version="11.3.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.0" />
    <PackageReference Include="Twilio" Version="7.14.3" />
    <PackageReference Include="Twilio.AspNet.Core" Version="8.1.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RewardProgram.Infrastructure\RewardProgram.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Controllers\Admin\" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="App_Data\firebase-credentials.json"
             Condition="Exists('App_Data\firebase-credentials.json')"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Update="web.Staging.config" CopyToPublishDirectory="Never" CopyToOutputDirectory="Never" />
    <Content Update="web.UAT.config"     CopyToPublishDirectory="Never" CopyToOutputDirectory="Never" />
    <None Update="web.Staging.config" CopyToPublishDirectory="Never" CopyToOutputDirectory="Never" />
    <None Update="web.UAT.config"     CopyToPublishDirectory="Never" CopyToOutputDirectory="Never" />
  </ItemGroup>

  <!--
    Swap the correct environment web.config template into the publish output.
    Each publish profile (.pubxml) declares <EnvTemplate>web.Staging.config</EnvTemplate>
    or <EnvTemplate>web.UAT.config</EnvTemplate> — no inference, no silent fallback.
    Publish fails if EnvTemplate is missing or the template file is not on disk,
    so we never ship the placeholder web.config to a real environment.
  -->
  <Target Name="SwapEnvironmentWebConfig" AfterTargets="CopyFilesToPublishDirectory">
    <Error Text="EnvTemplate is not set for this publish profile. Add &lt;EnvTemplate&gt;web.Staging.config&lt;/EnvTemplate&gt; (or web.UAT.config) to the .pubxml before publishing."
           Condition="'$(EnvTemplate)' == ''" />
    <Error Text="EnvTemplate '$(EnvTemplate)' was not found next to the csproj. Confirm the file exists and is not gitignored away on this machine."
           Condition="'$(EnvTemplate)' != '' And !Exists('$(MSBuildProjectDirectory)\$(EnvTemplate)')" />
    <Message Text="Swapping $(EnvTemplate) into web.config for publish" Importance="High" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\$(EnvTemplate)"
          DestinationFiles="$(PublishDir)web.config"
          OverwriteReadOnlyFiles="true" />
  </Target>

</Project>
