{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=RewardAppDb;Trusted_Connection=True;Encrypt=False"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "ApplicationName": "RewardProgram"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "REPLACE_WITH_SECURE_KEY_IN_ENVIRONMENT",
    "Issuer": "RewardApp",
    "Audience": "RewardApp users",
    "AdminAudience": "RewardApp admin",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 30,
    "AdminAccessTokenExpirationMinutes": 15,
    "AdminRefreshTokenExpirationDays": 30
  },
  "AllowedOrigins": [
    "http://localhost:3000",
    "http://localhost:3001",
    "http://localhost:4200",
    "https://admin.raedrewardapp.com",
    "https://app.raedrewardapp.com",
    "http://staging.raedrewardapp.com",
    "https://staging.raedrewardapp.com",
    "https://heroic-pithivier-075633.netlify.app",
    "http://adminuat.raedrewardapp.com",
    "https://adminuat.raedrewardapp.com",
    "http://uat.raedrewardapp.com",
    "https://uat.raedrewardapp.com"
  ],
  "Firebase": {
    "Enabled": false,
    "ServiceAccountKeyPath": ""
  },
  "Twilio": {
    "AccountSid": "",
    "AuthToken": "",
    "VerifyServiceSid": "",
    "UseMockMode": true,
    "SmsFromNumber": "",
    "WhatsAppFromNumber": ""
  }
}
