{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Twilio": {
    "AccountSid": "YOUR_TWILIO_ACCOUNT_SID",
    "AuthToken": "YOUR_TWILIO_AUTH_TOKEN",
    "VerifyServiceSid": "YOUR_TWILIO_VERIFY_SERVICE_SID",
    "UseMockMode": false,
    "SmsFromNumber": "YOUR_TWILIO_SMS_NUMBER",
    "WhatsAppFromNumber": "whatsapp:YOUR_TWILIO_WHATSAPP_NUMBER"
  }
}
