{
	"info": {
		"name": "RewardProgram — Admin API",
		"description": "Admin User Management endpoints (12 endpoints)\n\nBase URL: http://staging.raedrewardapp.com\n\nRequires SystemAdmin JWT token.\n\n**To get a token:**\n1. Use the Public API collection to Login with SystemAdmin mobile `0500000001`\n2. Verify Login with any OTP → copy the JWT token here",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://staging.raedrewardapp.com"
		},
		{
			"key": "token",
			"value": ""
		},
		{
			"key": "userId",
			"value": ""
		}
	],
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{token}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "Add User",
			"item": [
				{
					"name": "Add SalesMan",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"أحمد المندوب\",\n  \"mobileNumber\": \"0512345678\",\n  \"cityIds\": [\"city-id-1\", \"city-id-2\"]\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{baseUrl}}/api/admin/users/salesman",
							"host": ["{{baseUrl}}"],
							"path": ["api", "admin", "users", "salesman"]
						},
						"description": "Create a new SalesMan and assign cities."
					}
				},
				{
					"name": "Add ZoneManager",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"خالد المدير\",\n  \"mobileNumber\": \"0512345679\",\n  \"regionId\": \"region-id-1\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{baseUrl}}/api/admin/users/zone-manager",
							"host": ["{{baseUrl}}"],
							"path": ["api", "admin", "users", "zone-manager"]
						},
						"description": "Create a new ZoneManager and assign to a region."
					}
				},
				{
					"name": "Add ShopOwner",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{ "key": "ownerName", "value": "محمد صاحب المحل", "type": "text" },
								{ "key": "mobileNumber", "value": "0512345680", "type": "text" },
								{ "key": "customerCode", "value": "10001", "type": "text", "description": "Must exist in ErpCustomer table" },
								{ "key": "cityId", "value": "city-id-1", "type": "text" },
								{ "key": "storeName", "value": "متجر الرائد", "type": "text", "description": "Required — 2-150 chars" },
								{ "key": "vat", "value": "300000000000003", "type": "text", "description": "Required — 15-digit VAT (starts & ends with 3)" },
								{ "key": "crn", "value": "1234567890", "type": "text", "description": "Required — 10-digit CRN" },
								{ "key": "shortAddress", "value": "ABCD1234", "type": "text", "description": "Required — 8-char alphanumeric short address" },
								{ "key": "shopImage", "type": "file", "src": "", "description": "Required — JPG/PNG, max 5MB" },
								{ "key": "nationalAddress.buildingNumber", "value": "1234", "type": "text" },
								{ "key": "nationalAddress.street", "value": "شارع الملك فهد", "type": "text" },
								{ "key": "nationalAddress.postalCode", "value": "12345", "type": "text" },
								{ "key": "nationalAddress.subNumber", "value": "1", "type": "text" },
								{ "key": "nationalAddress.district", "value": "حي النزهة", "type": "text", "description": "Optional district name" }
							]
						},
						"url": {
							"raw": "{{baseUrl}}/api/admin/users/shop-owner",
							"host": ["{{baseUrl}}"],
							"path": ["api", "admin", "users", "shop-owner"]
						},
						"description": "Create a new ShopOwner with ShopData. All shop fields are always required.\nIf ShopData exists for this CustomerCode, it will be overwritten.\nUses form-data for file upload."
					}
				},
				{
					"name": "Add Seller",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{ "key": "name", "value": "سعد البائع", "type": "text" },
								{ "key": "mobileNumber", "value": "0512345681", "type": "text" },
								{ "key": "customerCode", "value": "10002", "type": "text", "description": "Must exist in ErpCustomer table" },
								{ "key": "cityId", "value": "city-id-1", "type": "text" },
								{ "key": "storeName", "value": "متجر البائع", "type": "text", "description": "Required if first for this CustomerCode" },
								{ "key": "vat", "value": "300000000000013", "type": "text" },
								{ "key": "crn", "value": "1234567891", "type": "text" },
								{ "key": "shortAddress", "value": "EFGH5678", "type": "text", "description": "8-char alphanumeric short address" },
								{ "key": "shopImage", "type": "file", "src": "", "description": "Optional shop image" },
								{ "key": "nationalAddress.buildingNumber", "value": "5678", "type": "text" },
								{ "key": "nationalAddress.street", "value": "شارع العليا", "type": "text" },
								{ "key": "nationalAddress.postalCode", "value": "54321", "type": "text" },
								{ "key": "nationalAddress.subNumber", "value": "2", "type": "text" },
								{ "key": "nationalAddress.district", "value": "حي الورود", "type": "text", "description": "Optional district name" }
							]
						},
						"url": {
							"raw": "{{baseUrl}}/api/admin/users/seller",
							"host": ["{{baseUrl}}"],
							"path": ["api", "admin", "users", "seller"]
						},
						"description": "Create a new Seller with ShopData. Uses form-data for file upload."
					}
				},
				{
					"name": "Add Technician",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"فهد الفني\",\n  \"mobileNumber\": \"0512345682\",\n  \"cityId\": \"city-id-1\",\n  \"postalCode\": \"12345\",\n  \"district\": \"حي السلام\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{baseUrl}}/api/admin/users/technician",
							"host": ["{{baseUrl}}"],
							"path": ["api", "admin", "users", "technician"]
						},
						"description": "Create a new Technician."
					}
				}
			]
		},
		{
			"name": "List & Status",
			"item": [
				{
					"name": "List Users",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/admin/users?page=1&pageSize=20",
							"host": ["{{baseUrl}}"],
							"path": ["api", "admin", "users"],
							"query": [
								{ "key": "search", "value": "", "disabled": true, "description": "Search by name or mobile" },
								{ "key": "userType", "value": "1", "description": "1=ShopOwner, 2=Seller, 3=Technician, 4=SalesMan, 5=ZoneManager", "disabled": true },
								{ "key": "registrationStatus", "value": "3", "description": "1=PendingSalesman, 2=PendingZoneManager, 3=Approved, 4=Rejected", "disabled": true },
								{ "key": "regionId", "value": "", "disabled": true },
								{ "key": "isDisabled", "value": "false", "disabled": true },
								{ "key": "page", "value": "1" },
								{ "key": "pageSize", "value": "20" }
							]
						},
						"description": "List/search/filter users with pagination. Enable disabled query params to filter."
					}
				},
				{
					"name": "List Users — Filter by UserType",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/admin/users?userType=4&page=1&pageSize=20",
							"host": ["{{baseUrl}}"],
							"path": ["api", "admin", "users"],
							"query": [
								{ "key": "userType", "value": "4", "description": "SalesMan" },
								{ "key": "page", "value": "1" },
								{ "key": "pageSize", "value": "20" }
							]
						},
						"description": "Example: filter by SalesMan (userType=4)."
					}
				},
				{
					"name": "List Users — Search by Name/Mobile",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/admin/users?search=أحمد&page=1&pageSize=20",
							"host": ["{{baseUrl}}"],
							"path": ["api", "admin", "users"],
							"query": [
								{ "key": "search", "value": "أحمد" },
								{ "key": "page", "value": "1" },
								{ "key": "pageSize", "value": "20" }
							]
						},
						"description": "Example: search users by name or mobile."
					}
				},
				{
					"name": "Toggle Status (Activate/Deactivate)",
					"request": {
						"method": "PATCH",
						"url": {
							"raw": "{{baseUrl}}/api/admin/users/:userId/toggle-status",
							"host": ["{{baseUrl}}"],
							"path": ["api", "admin", "users", ":userId", "toggle-status"],
							"variable": [
								{
									"key": "userId",
									"value": "",
									"description": "User ID to toggle"
								}
							]
						},
						"description": "Activate or deactivate a user."
					}
				}
			]
		},
