							"mode": "raw",
							"raw": "{\n  \"name\": \"خالد المدير\",\n  \"mobileNumber\": \"0512345679\",\n  \"regionId\": \"region-id-1\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{baseUrl}}/api/admin/users/zone-manager",
							"host": ["{{baseUrl}}"],
							"path": ["api", "admin", "users", "zone-manager"]
						},
						"description": "Create a new ZoneManager and assign to a region.\n\nName: 3+ letters only (Arabic/English), no numbers."
					}
				},
				{
					"name": "Add ShopOwner",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{ "key": "ownerName", "value": "محمد صاحب المحل", "type": "text", "description": "Required — 3+ letters only (Arabic/English), no numbers" },
								{ "key": "mobileNumber", "value": "0512345680", "type": "text" },
								{ "key": "customerCode", "value": "10001", "type": "text", "description": "Must exist in ErpCustomer table. Only one ShopOwner per CustomerCode." },
								{ "key": "cityId", "value": "city-id-1", "type": "text" },
								{ "key": "storeName", "value": "متجر الرائد", "type": "text", "description": "Required — 2-150 chars" },
								{ "key": "vat", "value": "300000000000003", "type": "text", "description": "Required — 15-digit VAT (starts & ends with 3)" },
								{ "key": "crn", "value": "1234567890", "type": "text", "description": "Required — 10-digit CRN" },
								{ "key": "shortAddress", "value": "ABCD1234", "type": "text", "description": "Required — 4 letters + 4 digits" },
								{ "key": "shopImage", "type": "file", "src": "", "description": "Required — JPG/PNG, max 5MB" },
								{ "key": "nationalAddress.buildingNumber", "value": "1234", "type": "text", "description": "Required — 4 digits (1000-9999)" },
								{ "key": "nationalAddress.street", "value": "شارع الملك فهد", "type": "text", "description": "Required — max 100 chars" },
								{ "key": "nationalAddress.postalCode", "value": "12345", "type": "text", "description": "Required — 5 digits" },
								{ "key": "nationalAddress.subNumber", "value": "1234", "type": "text", "description": "Required — 4 digits (1000-9999)" },
								{ "key": "nationalAddress.district", "value": "حي النزهة", "type": "text", "description": "Optional — max 100 chars" }
							]
						},
						"url": {
							"raw": "{{baseUrl}}/api/admin/users/shop-owner",
							"host": ["{{baseUrl}}"],
							"path": ["api", "admin", "users", "shop-owner"]
						},
						"description": "Create a new ShopOwner with ShopData. All shop fields are always required.\nOnly one ShopOwner per CustomerCode allowed.\nIf ShopData exists for this CustomerCode, it will be overwritten.\nUses form-data for file upload."
					}
				},
