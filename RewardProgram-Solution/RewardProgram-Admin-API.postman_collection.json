						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/admin/users?search=أحمد&page=1&pageSize=20",
							"host": ["{{baseUrl}}"],
							"path": ["api", "admin", "users"],
							"query": [
								{ "key": "search", "value": "أحمد" },
								{ "key": "page", "value": "1" },
								{ "key": "pageSize", "value": "20" }
							]
						},
						"description": "Example: search users by name or mobile."
					}
				},
				{
					"name": "Toggle Status (Activate/Deactivate)",
					"request": {
						"method": "PATCH",
						"url": {
							"raw": "{{baseUrl}}/api/admin/users/:userId/toggle-status",
							"host": ["{{baseUrl}}"],
							"path": ["api", "admin", "users", ":userId", "toggle-status"],
							"variable": [
								{
									"key": "userId",
									"value": "",
									"description": "User ID to toggle"
								}
							]
						},
						"description": "Activate or deactivate a user."
					}
				}
			]
		},
