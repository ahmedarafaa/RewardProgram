								{ "key": "mobileNumber", "value": "0512345681", "type": "text" },
								{ "key": "customerCode", "value": "10002", "type": "text", "description": "Must exist in ErpCustomer table" },
								{ "key": "cityId", "value": "city-id-1", "type": "text" },
								{ "key": "storeName", "value": "متجر البائع", "type": "text", "description": "Required if first for this CustomerCode" },
								{ "key": "vat", "value": "300000000000013", "type": "text" },
								{ "key": "crn", "value": "1234567891", "type": "text" },
								{ "key": "shortAddress", "value": "EFGH5678", "type": "text", "description": "4 letters + 4 digits" },
								{ "key": "shopImage", "type": "file", "src": "", "description": "Optional — JPG/PNG, max 5MB" },
								{ "key": "nationalAddress.buildingNumber", "value": "5678", "type": "text", "description": "Required — 4 digits (1000-9999)" },
								{ "key": "nationalAddress.street", "value": "شارع العليا", "type": "text", "description": "Required — max 100 chars" },
								{ "key": "nationalAddress.postalCode", "value": "54321", "type": "text", "description": "Required — 5 digits" },
								{ "key": "nationalAddress.subNumber", "value": "4321", "type": "text", "description": "Required — 4 digits (1000-9999)" },
								{ "key": "nationalAddress.district", "value": "حي الورود", "type": "text", "description": "Optional — max 100 chars" }
							]
