{
	"info": {
		"name": "RewardProgram — Admin API",
		"description": "Admin API endpoints — Users, Products, Barcodes, Scans, Reward Settings\n\nBase URL: http://staging.raedrewardapp.com\n\nRequires SystemAdmin JWT token.\n\n**To get a token:**\n1. Use the Public API collection to Login with SystemAdmin mobile `0500000001`\n2. Verify Login with any OTP → copy the JWT token here",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://staging.raedrewardapp.com"
		},
		{
			"key": "token",
			"value": ""
		},
		{
			"key": "userId",
			"value": ""
		},
		{
			"key": "productId",
			"value": ""
		}
	],
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{token}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "Users — Add",
			"item": [
				{
					"name": "Add SalesMan",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"أحمد المندوب\",\n  \"mobileNumber\": \"0512345678\",\n  \"cityIds\": [\"city-id-1\", \"city-id-2\"]\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{baseUrl}}/api/admin/users/salesman",
							"host": ["{{baseUrl}}"],
							"path": ["api", "admin", "users", "salesman"]
						},
						"description": "Create a new SalesMan and assign cities.\n\nName: 3+ letters only (Arabic/English), no numbers."
					}
				},
				{
					"name": "Add ZoneManager",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
