		{
			"name": "Products",
			"description": "Product management endpoints. Requires SystemAdmin JWT.",
			"item": [
				{
					"name": "Add Product",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"منتج تجريبي\",\n  \"productCode\": \"PROD001\",\n  \"pointValue\": 10,\n  \"price\": 99.99,\n  \"category\": \"فئة تجريبية\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{baseUrl}}/api/admin/products",
							"host": ["{{baseUrl}}"],
							"path": ["api", "admin", "products"]
						},
						"description": "Add a new product.\n\nName: required, max 200 chars.\nProductCode: required, max 50 chars, unique.\nPointValue: required, > 0.\nPrice: required, >= 0.\nCategory: optional, max 100 chars."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"if (pm.response.code === 200) {",
									"    var json = pm.response.json();",
									"    if (json.id) {",
									"        pm.collectionVariables.set('productId', json.id);",
									"        console.log('productId saved: ' + json.id);",
									"    }",
									"}"
								]
							}
						}
					]
				},
				{
					"name": "List Products",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/admin/products?page=1&pageSize=20",
							"host": ["{{baseUrl}}"],
							"path": ["api", "admin", "products"],
							"query": [
								{ "key": "search", "value": "", "disabled": true, "description": "Search by name or product code" },
								{ "key": "category", "value": "", "disabled": true, "description": "Filter by category" },
								{ "key": "page", "value": "1" },
								{ "key": "pageSize", "value": "20" }
							]
						},
						"description": "List/search/filter products with pagination."
					}
				},
				{
					"name": "Get Product",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/admin/products/:id",
							"host": ["{{baseUrl}}"],
							"path": ["api", "admin", "products", ":id"],
							"variable": [
								{
									"key": "id",
									"value": "{{productId}}",
									"description": "Product ID"
								}
							]
						},
						"description": "Get a product with barcode statistics (total/available counts)."
					}
				},
				{
					"name": "Edit Product",
					"request": {
						"method": "PUT",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"منتج معدل\",\n  \"productCode\": \"PROD001\",\n  \"pointValue\": 15,\n  \"price\": 149.99,\n  \"category\": \"فئة معدلة\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{baseUrl}}/api/admin/products/:id",
							"host": ["{{baseUrl}}"],
							"path": ["api", "admin", "products", ":id"],
							"variable": [
								{
									"key": "id",
									"value": "{{productId}}",
									"description": "Product ID"
								}
							]
						},
						"description": "Edit a product. Same validation as Add Product."
					}
				},
				{
					"name": "Delete Product",
					"request": {
						"method": "DELETE",
						"url": {
							"raw": "{{baseUrl}}/api/admin/products/:id",
							"host": ["{{baseUrl}}"],
							"path": ["api", "admin", "products", ":id"],
							"variable": [
								{
									"key": "id",
									"value": "{{productId}}",
									"description": "Product ID"
								}
							]
						},
						"description": "Delete a product. Blocked if the product has any barcodes.\n\nReturns 204 No Content on success."
					}
				}
			]
		},
