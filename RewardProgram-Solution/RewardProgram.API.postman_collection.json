{
  "info": {
    "name": "RewardProgram API",
    "description": "RewardProgram API - Auth, Approvals, Lookups, Scanning, Wallet\n\nBase URL: http://staging.raedrewardapp.com\n\n**OTP-first Registration Flow:**\n1. Send OTP → get pinId\n2. Register (shop-owner/seller/technician) with pinId + OTP → user created\n\n**Login Flow:**\n1. Login → get pinId\n2. Verify Login → get JWT + refreshToken",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://staging.raedrewardapp.com",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "pinId",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "description": "Authentication endpoints — registration, login, and token management.\n\nNo authentication required for registration and login. Token endpoints require JWT.",
      "item": [
        {
          "name": "Registration",
          "description": "User registration — OTP-first flow.\n\n1. Send OTP → get pinId\n2. Register with pinId + OTP → user created\n\nOptionally include an `InvitationCode` from an existing user's invite link.",
          "item": [
            {
              "name": "Send OTP",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"mobileNumber\": \"0555000001\"\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": {
                  "raw": "{{baseUrl}}/api/auth/send-otp",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "auth", "send-otp"]
                },
                "description": "Send registration OTP. Checks mobile uniqueness.\n\nAuto-saves `pinId` from response."
              },
              "response": [],
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code === 200) {",
                      "    var json = pm.response.json();",
                      "    if (json.pinId) {",
                      "        pm.collectionVariables.set('pinId', json.pinId);",
                      "        console.log('pinId saved: ' + json.pinId);",
                      "    }",
                      "}"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Register Shop Owner",
              "request": {
                "method": "POST",
                "header": [],
                "body": {
                  "mode": "formdata",
                  "formdata": [
                    { "key": "PinId", "value": "{{pinId}}", "type": "text", "description": "From Send OTP response" },
                    { "key": "Otp", "value": "123456", "type": "text", "description": "6-digit OTP" },
                    { "key": "CustomerCode", "value": "10001", "type": "text", "description": "Must exist in ErpCustomer table" },
                    { "key": "OwnerName", "value": "صاحب المتجر التجريبي", "type": "text", "description": "Required — 3+ letters only (Arabic/English), no numbers" },
                    { "key": "MobileNumber", "value": "0555000001", "type": "text" },
                    { "key": "CityId", "value": "CITY_ID_HERE", "type": "text", "description": "City GUID from Lookups" },
                    { "key": "StoreName", "value": "متجر التجربة", "type": "text", "description": "Required — 2-150 chars" },
                    { "key": "VAT", "value": "300000000000003", "type": "text", "description": "Required — 15-digit VAT (starts & ends with 3)" },
                    { "key": "CRN", "value": "1010000000", "type": "text", "description": "Required — 10-digit Commercial Registration Number" },
                    { "key": "ShortAddress", "value": "ABCD1234", "type": "text", "description": "Required — 4 letters + 4 digits" },
                    { "key": "ShopImage", "type": "file", "src": "", "description": "Required — JPG/PNG, max 5MB" },
                    { "key": "NationalAddress.BuildingNumber", "value": "1234", "type": "text", "description": "Required — 4 digits (1000-9999)" },
                    { "key": "NationalAddress.Street", "value": "شارع الملك فهد", "type": "text", "description": "Required — max 100 chars" },
                    { "key": "NationalAddress.PostalCode", "value": "12345", "type": "text", "description": "Required — 5 digits" },
                    { "key": "NationalAddress.SubNumber", "value": "6789", "type": "text", "description": "Required — 4 digits (1000-9999)" },
                    { "key": "NationalAddress.District", "value": "حي النزهة", "type": "text", "description": "Optional — max 100 chars" },
                    { "key": "InvitationCode", "value": "", "type": "text", "disabled": true, "description": "Optional — 8-char invitation code from an existing user's invite link" }
                  ]
                },
                "url": {
                  "raw": "{{baseUrl}}/api/auth/register/shop-owner",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "auth", "register", "shop-owner"]
                },
                "description": "Register a new shop owner. Uses form-data for file upload.\n\nShopOwner ALWAYS provides all shop data fields.\nIf ShopData was previously created by a Seller, the ShopOwner's data overwrites it.\nOnly one ShopOwner per CustomerCode allowed.\n\nRequires pinId + OTP from Send OTP step. OTP verified inline."
              },
              "response": []
            },
            {
              "name": "Register Seller",
              "request": {
                "method": "POST",
                "header": [],
                "body": {
                  "mode": "formdata",
                  "formdata": [
                    { "key": "PinId", "value": "{{pinId}}", "type": "text", "description": "From Send OTP response" },
                    { "key": "Otp", "value": "123456", "type": "text", "description": "6-digit OTP" },
                    { "key": "Name", "value": "بائع تجريبي", "type": "text", "description": "Required — 3+ letters only (Arabic/English), no numbers" },
                    { "key": "MobileNumber", "value": "0555000002", "type": "text" },
                    { "key": "CustomerCode", "value": "10001", "type": "text", "description": "Must exist in ErpCustomer table" },
                    { "key": "StoreName", "value": "متجر البائع", "type": "text", "description": "Required if first registration for this CustomerCode" },
                    { "key": "VAT", "value": "300000000000003", "type": "text" },
                    { "key": "CRN", "value": "1010000000", "type": "text" },
                    { "key": "ShortAddress", "value": "EFGH5678", "type": "text", "description": "4 letters + 4 digits" },
                    { "key": "ShopImage", "type": "file", "src": "", "description": "Optional shop image — JPG/PNG, max 5MB" },
                    { "key": "CityId", "value": "CITY_ID_HERE", "type": "text", "description": "City GUID from Lookups" },
                    { "key": "NationalAddress.Street", "value": "شارع العليا", "type": "text", "description": "Required — max 100 chars" },
                    { "key": "NationalAddress.BuildingNumber", "value": "5678", "type": "text", "description": "Required — 4 digits (1000-9999)" },
                    { "key": "NationalAddress.PostalCode", "value": "11111", "type": "text", "description": "Required — 5 digits" },
                    { "key": "NationalAddress.SubNumber", "value": "4321", "type": "text", "description": "Required — 4 digits (1000-9999)" },
                    { "key": "NationalAddress.District", "value": "حي الورود", "type": "text", "description": "Optional — max 100 chars" },
                    { "key": "InvitationCode", "value": "", "type": "text", "disabled": true, "description": "Optional — 8-char invitation code from an existing user's invite link" }
                  ]
                },
                "url": {
                  "raw": "{{baseUrl}}/api/auth/register/seller",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "auth", "register", "seller"]
                },
                "description": "Register a new seller. Uses form-data for file upload.\n\nFirst Seller for a CustomerCode provides shop data. Subsequent Sellers skip shop data.\n\nRequires pinId + OTP from Send OTP step."
              },
              "response": []
            },
            {
              "name": "Register Technician",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"pinId\": \"{{pinId}}\",\n  \"otp\": \"123456\",\n  \"name\": \"فني تجريبي\",\n  \"mobileNumber\": \"0555000003\",\n  \"cityId\": \"CITY_ID_HERE\",\n  \"postalCode\": \"12345\",\n  \"district\": \"حي السلام\",\n  \"invitationCode\": \"\"\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": {
                  "raw": "{{baseUrl}}/api/auth/register/technician",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "auth", "register", "technician"]
                },
                "description": "Register a new technician.\n\nName: 3+ letters only, no numbers.\nPostalCode: 5 digits.\n\nRequires pinId + OTP from Send OTP step."
              },
              "response": []
            },
            {
              "name": "Resend OTP",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"mobileNumber\": \"0555000001\"\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": {
                  "raw": "{{baseUrl}}/api/auth/resend-otp",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "auth", "resend-otp"]
                },
                "description": "Resend OTP to a mobile number. Auto-saves new pinId."
              },
              "response": [],
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code === 200) {",
                      "    var json = pm.response.json();",
                      "    if (json.pinId) {",
                      "        pm.collectionVariables.set('pinId', json.pinId);",
                      "    }",
                      "}"
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "name": "Login",
          "item": [
            {
              "name": "Login (Send OTP)",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"mobileNumber\": \"0500000001\"\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": {
                  "raw": "{{baseUrl}}/api/auth/login",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "auth", "login"]
                },
                "description": "Initiate login by sending OTP to mobile.\n\nSeeded users: SystemAdmin 0500000001, ZoneManager 0500000002, SalesMan 0500000010."
              },
              "response": [],
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code === 200) {",
                      "    var json = pm.response.json();",
                      "    if (json.pinId) {",
                      "        pm.collectionVariables.set('pinId', json.pinId);",
                      "    }",
                      "}"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Verify Login OTP",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"pinId\": \"{{pinId}}\",\n  \"otp\": \"123456\"\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": {
                  "raw": "{{baseUrl}}/api/auth/login/verify",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "auth", "login", "verify"]
                },
                "description": "Verify login with OTP. Auto-saves token and refreshToken."
              },
              "response": [],
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code === 200) {",
                      "    var json = pm.response.json();",
                      "    if (json.token) {",
                      "        pm.collectionVariables.set('token', json.token);",
                      "    }",
                      "    if (json.refreshToken) {",
                      "        pm.collectionVariables.set('refreshToken', json.refreshToken);",
                      "    }",
                      "}"
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "name": "Token",
          "item": [
            {
              "name": "Refresh Token",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": {
                  "raw": "{{baseUrl}}/api/auth/refresh-token",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "auth", "refresh-token"]
                },
                "description": "Refresh an expired JWT token. Requires authentication."
              },
              "response": [],
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code === 200) {",
                      "    var json = pm.response.json();",
                      "    if (json.token) {",
                      "        pm.collectionVariables.set('token', json.token);",
                      "    }",
                      "    if (json.refreshToken) {",
                      "        pm.collectionVariables.set('refreshToken', json.refreshToken);",
                      "    }",
                      "}"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Revoke Token (Logout)",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": {
                  "raw": "{{baseUrl}}/api/auth/revoke-token",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "auth", "revoke-token"]
                },
                "description": "Revoke refresh token (logout). Requires authentication."
              },
              "response": []
            }
          ]
        }
      ]
    },
    {
      "name": "Approvals",
      "description": "3-level approval flow for user registrations.\n\nSalesMan approves first (PendingSalesman → PendingZoneManager).\nZoneManager approves second (PendingZoneManager → Approved).\nOn final approval, invitation rewards are credited if the user was invited.\n\nRequires SalesMan or ZoneManager JWT.",
      "item": [
        {
          "name": "Get Pending Requests",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/approvals/pending?page=1&pageSize=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "approvals", "pending"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" }
              ]
            },
            "description": "Get pending registration requests. Requires SalesMan/ZoneManager JWT."
          },
          "response": []
        },
        {
          "name": "Approve User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"USER_ID_HERE\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/approvals/approve",
              "host": ["{{baseUrl}}"],
              "path": ["api", "approvals", "approve"]
            },
            "description": "Approve a pending user registration.\n\nSalesMan: PendingSalesman → PendingZoneManager.\nZoneManager: PendingZoneManager → Approved (triggers invitation rewards if invited).\n\nRequires SalesMan or ZoneManager JWT."
          },
          "response": []
        },
        {
          "name": "Reject User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"USER_ID_HERE\",\n  \"reason\": \"بيانات غير مكتملة\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/approvals/reject",
              "host": ["{{baseUrl}}"],
              "path": ["api", "approvals", "reject"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Lookups",
      "description": "Public lookup endpoints — no authentication required.\n\nUse these to get Region/City IDs for registration and to check ShopData status.",
      "item": [
        {
          "name": "Get Regions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/lookup/regions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "lookup", "regions"]
            },
            "description": "Returns all active regions."
          },
          "response": []
        },
        {
          "name": "Get Cities by Region",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/lookup/regions/:regionId/cities",
              "host": ["{{baseUrl}}"],
              "path": ["api", "lookup", "regions", ":regionId", "cities"],
              "variable": [
                {
                  "key": "regionId",
                  "value": "",
                  "description": "Region GUID from Get Regions"
                }
              ]
            },
            "description": "Returns cities for a specific region."
          },
          "response": []
        },
        {
          "name": "Get All Cities",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/lookup/cities",
              "host": ["{{baseUrl}}"],
              "path": ["api", "lookup", "cities"]
            },
            "description": "Returns all 140 active cities."
          },
          "response": []
        },
        {
          "name": "Check Shop Data Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/lookup/customer/:customerCode/shop-data-status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "lookup", "customer", ":customerCode", "shop-data-status"],
              "variable": [
                {
                  "key": "customerCode",
                  "value": "10001",
                  "description": "ERP Customer Code"
                }
              ]
            },
            "description": "Check if ShopData already exists for a CustomerCode.\n\nFor Seller registration only — determines if shop fields are needed.\nShopOwner always provides all shop fields regardless."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Scanning",
      "description": "Barcode scanning endpoints. Requires Seller or Technician JWT.",
      "item": [
        {
          "name": "Scan Barcode",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"barcodeCode\": \"ABCDEFGHIJKL\",\n  \"latitude\": 24.7136,\n  \"longitude\": 46.6753\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/scan",
              "host": ["{{baseUrl}}"],
              "path": ["api", "scan"]
            },
            "description": "Scan a barcode to earn points.\n\nBarcodeCode must be exactly 12 characters (NanoID).\nLatitude/Longitude are optional — sent by frontend if GPS is available.\nSeller and Technician each scan once per barcode.\nWhen both roles scan → barcode becomes Consumed.\n\nRequires Seller or Technician JWT."
          },
          "response": []
        },
        {
          "name": "Scan History",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/scan/history?page=1&pageSize=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "scan", "history"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" }
              ]
            },
            "description": "Get paginated scan history for the current user.\n\nRequires Seller or Technician JWT."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Wallet",
      "description": "Wallet and transaction endpoints. Requires Seller or Technician JWT.",
      "item": [
        {
          "name": "Get Balance",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/wallet/balance",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wallet", "balance"]
            },
            "description": "Get current point balance and SAR balance.\n\nRequires Seller or Technician JWT."
          },
          "response": []
        },
        {
          "name": "Transaction History",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/wallet/transactions?page=1&pageSize=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wallet", "transactions"],
              "query": [
                { "key": "type", "value": "1", "disabled": true, "description": "1=Earned, 2=Redeemed, 3=Cancelled (optional filter)" },
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" }
              ]
            },
            "description": "Get paginated wallet transactions with SAR amounts.\n\nRequires Seller or Technician JWT."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Invitation",
      "description": "Invitation/referral system endpoints.\n\nEach approved user gets a unique 8-char invitation code + QR code + shareable link.\nNew users can provide an invitation code at registration.\nWhen the invited user gets approved, both inviter (100 pts) and invitee (50 pts) receive rewards.\nInviter reward is capped at 20 approved invitations.\n\nRequires ShopOwner, Seller, or Technician JWT.",
      "item": [
        {
          "name": "Get Invitation Info",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/invitation",
              "host": ["{{baseUrl}}"],
              "path": ["api", "invitation"]
            },
            "description": "Get your invitation code, QR code (base64 BMP), shareable link, and invitation stats.\n\nLazy-generates the invitation code on first call if missing.\n\n**Response:**\n- `invitationCode`: 8-char alphanumeric code\n- `shareLink`: Full URL for sharing\n- `qrCodeBase64`: Base64-encoded BMP image of the QR code\n- `totalInvitations`: Total users who registered with your code\n- `approvedInvitations`: How many of those were approved\n- `totalPointsEarned`: Total points earned from invitation rewards\n\nRequires ShopOwner, Seller, or Technician JWT."
          },
          "response": []
        }
      ]
    }
  ]
}
